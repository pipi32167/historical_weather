  "about": {
    "developer": {
      "initial": "M",
      "name": "Million",
      "title": "全栈开发者 & 数据爱好者",
      "bio": "我是一名热爱技术的全栈开发者，对数据可视化和气象数据有着浓厚的兴趣。这个项目结合了我对Web开发和气象数据分析的热情，希望能为大家提供一个简单易用的历史天气查询工具。"
    },
    "project": {
      "title": "关于这个项目",
      "description1": "这是一个个人开发的历史天气数据查询平台，旨在让每个人都能轻松查看和比较不同年份同一日期的天气情况。",
      "description2": "项目采用现代Web技术栈构建，集成了Open-Meteo等开源气象数据API，为用户提供免费、准确的历史天气数据服务。",
      "description3": "无论您是想知道去年今天的天气，还是想研究某个日期的历史气温变化趋势，这个工具都能帮到您。"
    },
    "motivation": {
      "title": "为什么做这个项目",
      "description1": "作为一个对天气变化感兴趣的人，我经常想知道\"去年今天是不是也这么冷？\"或者\"这个日期历史上最热是多少度？\"。但发现很难找到一个简单易用的工具来查询这些信息。",
      "description2": "于是我决定自己动手做一个。希望这个小工具能帮助更多像我一样好奇的人，轻松探索历史天气数据的奥秘。"
    },
    "tech": {
      "title": "技术栈",
      "items": [
        "React 19 + TypeScript",
        "Tailwind CSS 响应式设计",
        "Recharts 数据可视化",
        "Open-Meteo API",
        "i18next 国际化"
      ]
    },
    "features": {
      "title": "功能特色",
      "items": [
        "历史同期天气对比",
        "逐小时天气预报",
